# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Data — keep folder structure, not contents (large datasets belong in DVC or remote lake)
data/*
!data/.gitkeep
!data/raw/
data/raw/*
!data/raw/.gitkeep

# Model artifacts — often large / regenerable from the pipeline
models/*
!models/.gitkeep

# Generated reports
outputs/*
!outputs/.gitkeep

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/
